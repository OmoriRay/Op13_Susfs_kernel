diff --git a/include/linux/compiler_types.h b/include/linux/compiler_types.h
--- a/include/linux/compiler_types.h
+++ b/include/linux/compiler_types.h
@@ -307,7 +307,11 @@
  * __bdos on clang < 19.1.3 can be off by 4:
  * https://github.com/llvm/llvm-project/pull/112636
  */
-#ifdef CONFIG_CC_HAS_COUNTED_BY
+/* counted_by does not change layout or calling convention. Keep its
+ * instrumentation in normal compilation, but exclude the annotation
+ * from legacy genksyms type hashes across compiler versions.
+ */
+#if defined(CONFIG_CC_HAS_COUNTED_BY) && !defined(__GENKSYMS__)
 # define __counted_by(member)		__attribute__((__counted_by__(member)))
 #else
 # define __counted_by(member)
